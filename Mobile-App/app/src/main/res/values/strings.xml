    <!-- About. Keep the privacy text in line with what the app actually does (DECISIONS D11). -->
    <string name="about_title">About</string>
    <string name="about_purpose_title">What PlantID does</string>
    <string name="about_purpose_body">PlantID helps you identify selected common indoor plants from a photo and explore their care guide.</string>
    <string name="about_prototype_title">Research prototype</string>
    <string name="about_prototype_body">PlantID is being built for an academic research project. It supports a limited set of plants, and its results are not a guarantee.</string>
    <string name="about_supported_title">Supported plants</string>
    <string name="about_supported_body">The list of supported plants will appear here once the project team has confirmed it.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">PlantID does not need an account and does not use the internet. When you take or choose a photo, PlantID keeps a temporary copy on this device so it can show it to you. Only the most recent photo is kept, and nothing is uploaded. Photos you take in PlantID are not added to your gallery.</string>
